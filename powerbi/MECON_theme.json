{
  "name": "M-ECON Navy Teal Coral",
  "dataColors": [
    "#00A6A6",
    "#FF6B4A",
    "#0B1F3A",
    "#F5B700",
    "#6C5CE7",
    "#4EA8DE",
    "#90A4BE",
    "#2A9D8F",
    "#E76F51",
    "#B8C4D6"
  ],
  "background": "#FFFFFF",
  "foreground": "#1B2A41",
  "tableAccent": "#00A6A6",
  "good": "#2A9D8F",
  "neutral": "#F5B700",
  "bad": "#E63946",
  "maximum": "#FF6B4A",
  "center": "#FFFFFF",
  "minimum": "#00A6A6",
  "hyperlink": "#00A6A6",
  "visitedHyperlink": "#6C5CE7",
  "textClasses": {
    "callout": {
      "fontSize": 30,
      "fontFace": "Segoe UI Semibold",
      "color": "#1B2A41"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#1B2A41"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#1B2A41"
    },
    "label": {
      "fontSize": 9,
      "fontFace": "Segoe UI",
      "color": "#6B7A90"
    },
    "largeTitle": {
      "fontSize": 16,
      "fontFace": "Segoe UI Bold",
      "color": "#1B2A41"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": false,
            "transparency": 100
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "visualHeader": [
          {
            "show": true,
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "foreground": {
              "solid": {
                "color": "#6B7A90"
              }
            },
            "transparency": 0
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#1B2A41"
              }
            },
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold",
            "alignment": "left"
          }
        ],
        "subTitle": [
          {
            "show": false,
            "fontColor": {
              "solid": {
                "color": "#6B7A90"
              }
            },
            "fontSize": 9
          }
        ],
        "padding": [
          {
            "top": 10,
            "bottom": 8,
            "left": 14,
            "right": 14
          }
        ],
        "categoryAxis": [
          {
            "gridlineShow": false,
            "labelColor": {
              "solid": {
                "color": "#6B7A90"
              }
            },
            "fontSize": 9,
            "titleFontSize": 9,
            "showAxisTitle": false
          }
        ],
        "valueAxis": [
          {
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#E6EAF2"
              }
            },
            "gridlineStyle": "dotted",
            "labelColor": {
              "solid": {
                "color": "#6B7A90"
              }
            },
            "fontSize": 9,
            "titleFontSize": 9
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "TopLeft",
            "labelColor": {
              "solid": {
                "color": "#6B7A90"
              }
            },
            "fontSize": 9
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#1B2A41"
              }
            },
            "fontSize": 9
          }
        ],
        "lineStyles": [
          {
            "strokeWidth": 2,
            "lineChartType": "smooth"
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F4F6FB"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F4F6FB"
              }
            }
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#1B2A41"
              }
            },
            "fontSize": 28,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#6B7A90"
              }
            },
            "fontSize": 10
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#1B2A41"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "textSize": 10
          }
        ],
        "header": [
          {
            "show": false
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#E6EAF2"
              }
            },
            "gridVertical": false,
            "rowPadding": 4
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#0B1F3A"
              }
            },
            "fontSize": 9
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#1B2A41"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#F7F9FC"
              }
            },
            "fontSize": 9
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#0B1F3A"
              }
            },
            "fontSize": 9
          }
        ],
        "rowHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#1B2A41"
              }
            },
            "fontSize": 9
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#1B2A41"
              }
            },
            "fontSize": 9
          }
        ]
      }
    },
    "actionButton": {
      "*": {
        "fill": [
          {
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#00A6A6"
              }
            }
          }
        ],
        "text": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 10
          }
        ]
      }
    }
  }
}