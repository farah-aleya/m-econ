// =====================================================================
// M-ECON Power BI measures. Paste each block into: Modeling > New measure
// (or New table for the tables marked NEW TABLE). Put all measures in a
// blank table called _Measures (Home > Enter data > name it _Measures).
// Table names assume you renamed each CSV without "powerbi_" (see guide).
// =====================================================================

// ---------- NEW TABLE: Calendar (mark as date table: Table tools > Mark as date table) ----------
Calendar =
ADDCOLUMNS (
    CALENDAR ( DATE ( 2010, 1, 1 ), DATE ( 2026, 12, 31 ) ),
    "Year", YEAR ( [Date] ),
    "Quarter", YEAR ( [Date] ) & " Q" & QUARTER ( [Date] ),
    "Month", FORMAT ( [Date], "mmm yyyy" )
)

// ---------- NEW TABLE: Brent Shock (What-if slider; or Modeling > New parameter > Numeric range) ----------
Brent Shock = GENERATESERIES ( -30, 30, 5 )
// then: Brent Shock Value = SELECTEDVALUE ( 'Brent Shock'[Value], 0 )

// ---------- NEW TABLE: Ringgit Shock (positive = ringgit weaker, USD/MYR up) ----------
Ringgit Shock = GENERATESERIES ( -10, 10, 1 )
// then: Ringgit Shock Value = SELECTEDVALUE ( 'Ringgit Shock'[Value], 0 )


// ===================== HOME / FORECAST KPIs =====================
GDP Forecast =
CALCULATE ( MAX ( Forecasts[forecast] ), Forecasts[setup] = "A2", Forecasts[selected] = TRUE () )

GDP Forecast Text = FORMAT ( [GDP Forecast], "0.0" ) & "%"

GDP Forecast Period =
VAR d = CALCULATE ( MAX ( Forecasts[forecast_for] ), Forecasts[setup] = "A2", Forecasts[selected] = TRUE () )
RETURN YEAR ( d ) & " Q" & QUARTER ( d )

GDP Latest =
CALCULATE ( MAX ( Forecasts[latest_actual] ), Forecasts[setup] = "A2", Forecasts[selected] = TRUE () )

GDP Model =
CALCULATE ( MAX ( Forecasts[model] ), Forecasts[setup] = "A2", Forecasts[selected] = TRUE () )

GDP Change Text =
VAR c = [GDP Forecast] - [GDP Latest]
RETURN IF ( c >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( c ), "0.0" ) & " pp vs latest " & FORMAT ( [GDP Latest], "0.0" ) & "%"

GDP Range 80 =
FORMAT ( CALCULATE ( MAX ( Forecasts[lo80] ), Forecasts[setup] = "A2", Forecasts[selected] = TRUE () ), "0.0" ) & "% to "
    & FORMAT ( CALCULATE ( MAX ( Forecasts[hi80] ), Forecasts[setup] = "A2", Forecasts[selected] = TRUE () ), "0.0" ) & "%"

GDP Subtitle = [GDP Forecast Period] & " · " & [GDP Model] & " · 80% range " & [GDP Range 80]

Inflation Forecast =
CALCULATE ( MAX ( Forecasts[forecast] ), Forecasts[setup] = "B", Forecasts[selected] = TRUE () )

Inflation Forecast Text = FORMAT ( [Inflation Forecast], "0.0" ) & "%"

Inflation Forecast Period =
FORMAT ( CALCULATE ( MAX ( Forecasts[forecast_for] ), Forecasts[setup] = "B", Forecasts[selected] = TRUE () ), "mmm yyyy" )

Inflation Latest =
CALCULATE ( MAX ( Forecasts[latest_actual] ), Forecasts[setup] = "B", Forecasts[selected] = TRUE () )

Inflation Model =
CALCULATE ( MAX ( Forecasts[model] ), Forecasts[setup] = "B", Forecasts[selected] = TRUE () )

Inflation Range 80 =
FORMAT ( CALCULATE ( MAX ( Forecasts[lo80] ), Forecasts[setup] = "B", Forecasts[selected] = TRUE () ), "0.0" ) & "% to "
    & FORMAT ( CALCULATE ( MAX ( Forecasts[hi80] ), Forecasts[setup] = "B", Forecasts[selected] = TRUE () ), "0.0" ) & "%"

Inflation Subtitle = [Inflation Forecast Period] & " · " & [Inflation Model] & " · 80% range " & [Inflation Range 80]

Inside BNM Range =
IF ( [Inflation Forecast] >= 1.5 && [Inflation Forecast] <= 2.5, "✔ Within BNM's 1.5% to 2.5% projection", "Outside BNM's 1.5% to 2.5% projection" )


// ===================== MODEL ACCURACY =====================
GDP Model MAE =
VAR m = [GDP Model]
RETURN CALCULATE ( MIN ( ModelResults[MAE] ), ModelResults[setup] = "A2", ModelResults[model] = m )

GDP Gain vs Naive =
VAR m = [GDP Model]
RETURN CALCULATE ( MIN ( ModelResults[mae_vs_naive_pct] ), ModelResults[setup] = "A2", ModelResults[model] = m )

GDP Gain Text = FORMAT ( [GDP Gain vs Naive], "+0.0;-0.0" ) & "%"

Inflation Model MAE =
VAR m = [Inflation Model]
RETURN CALCULATE ( MIN ( ModelResults[MAE] ), ModelResults[setup] = "B", ModelResults[model] = m )

Inflation Gain Text =
VAR m = [Inflation Model]
RETURN FORMAT ( CALCULATE ( MIN ( ModelResults[mae_vs_naive_pct] ), ModelResults[setup] = "B", ModelResults[model] = m ), "+0.0;-0.0" ) & "%"

// bar colour for the accuracy chart: selected model amber, beats naive teal, others grey
Model Bar Colour =
VAR sel = IF ( SELECTEDVALUE ( ModelResults[setup] ) = "B", [Inflation Model], [GDP Model] )
RETURN SWITCH ( TRUE (),
    SELECTEDVALUE ( ModelResults[model] ) = sel, "#F5B700",
    SELECTEDVALUE ( ModelResults[mae_vs_naive_pct] ) > 0, "#00A6A6",
    "#B8C4D6" )

Test Chart Title =
"Actual vs " & SELECTEDVALUE ( Predictions[model], "each model" ) & ": one-step-ahead forecasts, 2022 to 2026"


// ===================== HISTORY (Calendar related to Quarterly / Monthly / Events) =====================
GDP Growth = CALCULATE ( AVERAGE ( Quarterly[value] ), Quarterly[variable] = "gdp_yoy" )
CPI Inflation Q = CALCULATE ( AVERAGE ( Quarterly[value] ), Quarterly[variable] = "cpi_yoy" )
CPI Inflation = CALCULATE ( AVERAGE ( Monthly[value] ), Monthly[variable] = "cpi_yoy" )
PPI Inflation = CALCULATE ( AVERAGE ( Monthly[value] ), Monthly[variable] = "ppi_yoy" )
PPI CPI Gap = [PPI Inflation] - [CPI Inflation]

Latest PPI CPI Gap Text =
VAR d = CALCULATE ( MAX ( Monthly[date] ), Monthly[variable] = "ppi_yoy", NOT ISBLANK ( Monthly[value] ), ALL ( Calendar ) )
VAR g = CALCULATE ( [PPI CPI Gap], Calendar[Date] = d )
RETURN FORMAT ( g, "+0.0;-0.0" ) & " pp (" & FORMAT ( d, "mmm yyyy" ) & ")"

RON95 Price = CALCULATE ( AVERAGE ( Monthly[value] ), Monthly[variable] = "fuel_ron95_market" )
RON95 BUDI95 Price = CALCULATE ( AVERAGE ( Monthly[value] ), Monthly[variable] = "fuel_ron95_budi95" )
Diesel Price = CALCULATE ( AVERAGE ( Monthly[value] ), Monthly[variable] = "fuel_diesel_peninsular" )

Event Marker = IF ( COUNTROWS ( Events ) > 0, 1 )
Event Names = CONCATENATEX ( Events, FORMAT ( Events[date], "mmm yyyy" ) & ": " & Events[event], UNICHAR ( 10 ) )


// ===================== EARLY WARNING =====================
Cost Status = LOOKUPVALUE ( EWStatus[status], EWStatus[signal], "Cost pressure" )
Growth Status = LOOKUPVALUE ( EWStatus[status], EWStatus[signal], "Growth slowdown" )
Cost Status Colour = IF ( [Cost Status] = "ON", "#E63946", "#2A9D8F" )
Growth Status Colour = IF ( [Growth Status] = "ON", "#E63946", "#2A9D8F" )

Cost Detail =
"as of " & FORMAT ( LOOKUPVALUE ( EWStatus[as_of], EWStatus[signal], "Cost pressure" ), "mmm yyyy" ) & " · "
    & LOOKUPVALUE ( EWStatus[indicators_on], EWStatus[signal], "Cost pressure" ) & " of 3 indicators high"

Growth Detail =
"as of " & FORMAT ( LOOKUPVALUE ( EWStatus[as_of], EWStatus[signal], "Growth slowdown" ), "mmm yyyy" ) & " · "
    & LOOKUPVALUE ( EWStatus[indicators_on], EWStatus[signal], "Growth slowdown" ) & " of 3 indicators low"

// checklist table: one row per indicator, latest published month
Indicator Latest Date =
CALCULATE ( MAX ( EWIndicators[date] ), ALLEXCEPT ( EWIndicators, EWIndicators[indicator] ), NOT ISBLANK ( EWIndicators[flag] ) )

Indicator Status =
VAR d = [Indicator Latest Date]
RETURN CALCULATE ( MAX ( EWIndicators[status] ), ALLEXCEPT ( EWIndicators, EWIndicators[indicator] ), EWIndicators[date] = d )

Indicator Status Colour =
SWITCH ( [Indicator Status], "Above usual range", "#E63946", "Normal", "#2A9D8F", "#B8C4D6" )

Indicator Month = FORMAT ( [Indicator Latest Date], "mmm yyyy" )

Cost Count = SUM ( EarlyWarning[cost_count] )
Growth Count = SUM ( EarlyWarning[growth_count] )


// ===================== BNM STATEMENT TONE =====================
Latest Tone Date = CALCULATE ( MAX ( MPCTone[date] ), ALL ( MPCTone ) )
Latest Tone =
VAR d = [Latest Tone Date]
RETURN CALCULATE ( MAX ( MPCTone[tone_rel] ), ALL ( MPCTone ), MPCTone[date] = d )
Latest Tone Text = FORMAT ( [Latest Tone], "+0.0;-0.0" ) & " sd"
Latest Stance =
VAR d = [Latest Tone Date]
RETURN CALCULATE ( MAX ( MPCTone[stance] ), ALL ( MPCTone ), MPCTone[date] = d )
Tone Subtitle = "BNM statement, " & FORMAT ( [Latest Tone Date], "d mmm yyyy" ) & " · " & [Latest Stance]
Tone Bar Colour = IF ( SELECTEDVALUE ( MPCTone[tone_rel] ) >= 0, "#FF6B4A", "#00A6A6" )


// ===================== STATES =====================
State Latest Date = CALCULATE ( MAX ( StateInflation[date] ), ALL ( StateInflation ) )
State CPI Latest =
VAR d = [State Latest Date]
RETURN CALCULATE ( AVERAGE ( StateInflation[cpi_yoy] ), StateInflation[date] = d )
State Food Latest =
VAR d = [State Latest Date]
RETURN CALCULATE ( AVERAGE ( StateInflation[food_yoy] ), StateInflation[date] = d )
State Transport Latest =
VAR d = [State Latest Date]
RETURN CALCULATE ( AVERAGE ( StateInflation[transport_yoy] ), StateInflation[date] = d )


// ===================== SCENARIOS (slider) =====================
Brent Shock Value = SELECTEDVALUE ( 'Brent Shock'[Value], 0 )
Ringgit Shock Value = SELECTEDVALUE ( 'Ringgit Shock'[Value], 0 )

GDP Effect =
[Brent Shock Value] * LOOKUPVALUE ( ScenarioSlider[brent_effect_per_1pct], ScenarioSlider[setup], "A2" )
    + [Ringgit Shock Value] * LOOKUPVALUE ( ScenarioSlider[ringgit_effect_per_1pct], ScenarioSlider[setup], "A2" )

Inflation Effect =
[Brent Shock Value] * LOOKUPVALUE ( ScenarioSlider[brent_effect_per_1pct], ScenarioSlider[setup], "B" )
    + [Ringgit Shock Value] * LOOKUPVALUE ( ScenarioSlider[ringgit_effect_per_1pct], ScenarioSlider[setup], "B" )

GDP Effect Text = FORMAT ( [GDP Effect], "+0.00;-0.00;0.00" ) & " pp"
Inflation Effect Text = FORMAT ( [Inflation Effect], "+0.00;-0.00;0.00" ) & " pp"
GDP After Shock Text = FORMAT ( [GDP Forecast], "0.0" ) & "% → " & FORMAT ( [GDP Forecast] + [GDP Effect], "0.0" ) & "%"
Inflation After Shock Text = FORMAT ( [Inflation Forecast], "0.0" ) & "% → " & FORMAT ( [Inflation Forecast] + [Inflation Effect], "0.0" ) & "%"
GDP Effect Colour = IF ( [GDP Effect] >= 0, "#00A6A6", "#E63946" )
Inflation Effect Colour = IF ( [Inflation Effect] > 0, "#FF6B4A", "#00A6A6" )

Scenario Sentence =
VAR b = [Brent Shock Value]
VAR r = [Ringgit Shock Value]
RETURN
    "If Brent moves " & FORMAT ( b, "+0;-0;0" ) & "% and the ringgit "
        & IF ( r >= 0, "weakens ", "strengthens " ) & ABS ( r ) & "%, the model projects GDP growth "
        & FORMAT ( [GDP Effect], "+0.00;-0.00;0.00" ) & " pp next quarter and inflation "
        & FORMAT ( [Inflation Effect], "+0.00;-0.00;0.00" ) & " pp next month. "
        & "Model projection, not a forecast: neither effect is statistically significant (p > 0.2), and fuel subsidies dampen pass-through."
